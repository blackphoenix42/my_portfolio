# .editorconfig — keep coding styles consistent across editors
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

# Markdown often uses two trailing spaces for line breaks
[*.md]
trim_trailing_whitespace = false

[*.{ts,tsx,js,jsx,mjs,cjs,json,yml,yaml,css,scss,html}]
indent_size = 2

[*.sh]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab

[*.patch]
trim_trailing_whitespace = false
