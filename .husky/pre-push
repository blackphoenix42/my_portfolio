# .husky/pre-push — the heavy gate. Runs everything CI would run so you never
# push a red bar: prettier format check, ESLint, markdown lint, typecheck,
# the full Vitest unit/component suite **with coverage thresholds**, and a
# production build. Bypass only in genuine emergencies with `git push --no-verify`.
set -e
echo "🚀 pre-push: format + lint + typecheck + tests (with coverage) + build"
npm run -s format:check
npm run -s lint
npm run -s lint:md
npm run -s typecheck
npm run -s test:coverage
echo "✅ pre-push passed."
