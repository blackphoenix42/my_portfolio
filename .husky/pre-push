# .husky/pre-push — the heavy gate. Runs everything CI would run so you never
# push a red bar: prettier format check, ESLint, markdown lint, typecheck,
# and the full Vitest unit/component suite. Bypass only in genuine emergencies
# with `git push --no-verify`.
echo "🚀 pre-push: format + lint + typecheck + tests"
npm run -s format:check
npm run -s lint
npm run -s lint:md
npm run -s typecheck
npm test -- --run
