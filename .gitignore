# .gitignore — files Git should never track. Keep build artifacts, secrets,
# coverage reports, and local IDE state out of source control.

# Node
node_modules
.next
out
dist

# Env
.env
.env.local
.env.*.local

# Logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Editor / OS
.DS_Store
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea

# Tests
test-results/
playwright-report/
playwright/.cache/
coverage/
.lighthouseci/

# TS
*.tsbuildinfo
next-env.d.ts
