{
  "name": "ayush-yadav-portfolio",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--disable-warning=DEP0205 next dev",
    "build": "cross-env NODE_OPTIONS=--disable-warning=DEP0205 next build",
    "start": "cross-env NODE_OPTIONS=--disable-warning=DEP0205 next start",
    "lint": "eslint . --max-warnings=0",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#.next\" \"#coverage\" \"#playwright-report\" \"#test-results\"",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "cross-env NODE_OPTIONS=--disable-warning=DEP0205 vitest",
    "test:coverage": "cross-env NODE_OPTIONS=--disable-warning=DEP0205 vitest run --coverage",
    "test:e2e": "cross-env NODE_OPTIONS=--disable-warning=DEP0205 playwright test",
    "a11y": "cross-env NODE_OPTIONS=--disable-warning=DEP0205 playwright test tests/a11y.spec.ts --project=chromium",
    "test:e2e:build": "next build && npm run test:e2e",
    "a11y:build": "next build && npm run a11y",
    "lhci": "lhci autorun",
    "lhci:collect": "lhci collect",
    "lhci:assert": "lhci assert",
    "lhci:audit": "next build && lhci autorun",
    "adr": "node scripts/adr-new.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "country-flag-icons": "1.6.17",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.17.0",
    "next": "16.2.6",
    "next-intl": "4.12.0",
    "next-themes": "^0.4.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "resend": "^6.12.4",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.3",
    "@commitlint/cli": "21.0.1",
    "@commitlint/config-conventional": "21.0.1",
    "@eslint/eslintrc": "3.3.5",
    "@lhci/cli": "^0.15.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "4.3.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.1",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.7",
    "autoprefixer": "^10.5.0",
    "axe-core": "4.11.4",
    "cross-env": "10.1.0",
    "eslint": "^10.4.0",
    "eslint-config-next": "16.2.6",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "husky": "9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "17.0.5",
    "markdownlint-cli2": "0.22.1",
    "postcss": "8.5.15",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "overrides": {
    "glob": "^13.0.6",
    "next": {
      "postcss": "^8.5.15"
    }
  },
  "browserslist": [
    "Chrome >= 109",
    "Edge >= 109",
    "Firefox >= 115",
    "Safari >= 16.4",
    "iOS >= 16.4",
    "not dead",
    "not op_mini all"
  ]
}
