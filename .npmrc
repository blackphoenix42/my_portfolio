; .npmrc — project-scoped npm settings

registry=https://registry.npmjs.org/

; Installs & lockfiles
package-lock=true
save-exact=true
legacy-peer-deps=true
strict-peer-deps=false
prefer-dedupe=true
engine-strict=false

; Output & UX
progress=false
loglevel=warn
color=true
update-notifier=false
fund=false

; Security/Audit (toggle locally if you want)
audit=false
