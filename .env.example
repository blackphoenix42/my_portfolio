# Public site URL (used for SEO + sitemap + OG)
NEXT_PUBLIC_SITE_URL=https://binaryphoenix.vercel.app

# Contact form (Resend) — sender domain must be verified on Resend before
# CONTACT_FROM_EMAIL can be a custom address; without verification, use
# `onboarding@resend.dev` as the sender.
RESEND_API_KEY=
CONTACT_TO_EMAIL=aayush.sang@gmail.com
CONTACT_FROM_EMAIL="onboarding@resend.dev"

# Optional: GitHub token to raise API rate limits for the workbench
GITHUB_TOKEN=

# Optional server-backed Ask Ayush inference. Keep disabled until privacy,
# evaluation, and provider-cost controls are approved (ADR-0014).
CHAT_API_ENABLED=false
CHAT_API_KEY=
CHAT_API_BASE_URL=https://api.openai.com/v1
CHAT_API_MODEL=
CHAT_DAILY_SPEND_CAP_USD=5

# Show phone number publicly (default false)
NEXT_PUBLIC_SHOW_PHONE=false
NEXT_PUBLIC_PHONE=
