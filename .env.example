# Public site URL (used for SEO + sitemap)
NEXT_PUBLIC_SITE_URL=https://ayushyadav.dev

# Contact form (Resend)
RESEND_API_KEY=
CONTACT_TO_EMAIL=aayush.sang@gmail.com
CONTACT_FROM_EMAIL="Ayush Portfolio <noreply@ayushyadav.dev>"

# Optional: GitHub token to raise API rate limits for repo fetch
GITHUB_TOKEN=

# Show phone number publicly (default false)
NEXT_PUBLIC_SHOW_PHONE=false
NEXT_PUBLIC_PHONE=

# Rate limiting (Upstash optional). If unset, in-memory fallback is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
